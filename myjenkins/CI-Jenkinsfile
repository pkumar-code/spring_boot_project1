pipeline {
    agent any
  
      tools {
        maven 'mymaven3'
        jdk 'myjdk17'
      }
  
      stages {      
    
          stage('1. Build the Bookstore Application') {
              steps { 
                      echo 'pwd'      
                      echo 'mvn  clean install package'
              }
          }
          
          stage('2. Copy the Application War to mydocker') {
             steps { 
                     echo 'pwd'
                     echo 'cp -r target/*.war mydocker'
             }
          }
           
          stage('3. Build and Push docker image') {

             steps {
                 script {         
                   def customImage = docker.build('dandesacademy/jlc-bookstore', "./mydocker")
                   docker.withRegistry('https://registry-1.docker.io/v2/', 'mydockerhub') {
                   customImage.push("5.1.0")
                   }                     
             }
          }
    }
  
      }
  }
  
